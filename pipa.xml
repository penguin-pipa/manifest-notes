<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- PenguinOS fork with the pipa product and device manifest -->
  <remove-project name="Project-PenguinOS/android_vendor_aospa" />
  <project path="vendor/aospa"
           name="penguin-pipa/android_vendor_aospa"
           remote="github"
           revision="celerity">
    <linkfile src="build.sh" dest="rom-build.sh" />
  </project>

  <!-- Pipa uses the aospa-pipa fork of vendor/qcom/opensource/power declared
       in beans.xml; drop the upstream project so barista can re-declare the
       path at lunch. -->
  <remove-project path="vendor/qcom/opensource/power" optional="true" />

  <!-- PenguinOS hardware/interfaces + kernel_config_t_4.19 -->
  <remove-project name="Project-PenguinOS/hardware_interfaces" />
  <project path="hardware/interfaces"
           name="penguin-pipa/android_hardware_interfaces"
           remote="github"
           revision="celerity" />

  <!-- PenguinOS forks with the aospa-pipa deltas for pipa -->
  <remove-project name="Project-PenguinOS/system_core" />
  <project path="system/core"
           name="penguin-pipa/system_core"
           remote="github"
           revision="celerity" />

  <remove-project name="Project-PenguinOS/frameworks_base" />
  <project path="frameworks/base"
           name="penguin-pipa/frameworks_base"
           remote="github"
           revision="celerity" />

  <remove-project name="Project-PenguinOS/frameworks_av" />
  <project path="frameworks/av"
           name="penguin-pipa/frameworks_av"
           remote="github"
           revision="celerity" />

  <remove-project name="Project-PenguinOS/packages_apps_ThemePicker" />
  <project path="packages/apps/ThemePicker"
           name="penguin-pipa/packages_apps_ThemePicker"
           remote="github"
           revision="celerity" />

  <!-- Cloned directly from YumeMichi's tree -->
  <remove-project name="Project-PenguinOS/packages_apps_LMOFreeform" />
  <project path="packages/apps/LMOFreeform"
           name="aospa-pipa/android_packages_apps_LMOFreeform"
           remote="github"
           revision="calcite" />
</manifest>
